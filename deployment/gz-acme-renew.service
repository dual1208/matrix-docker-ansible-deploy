[Unit]
Description=Renew and verify the gz short-lived IP certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gz-acme-renew
TimeoutStartSec=20min
UMask=0077
