[Unit]
Description=Check gz short-lived IP certificate renewal every six hours

[Timer]
OnCalendar=*-*-* 00,06,12,18:35:00
Persistent=true
AccuracySec=1min
Unit=gz-acme-renew.service

[Install]
WantedBy=timers.target
